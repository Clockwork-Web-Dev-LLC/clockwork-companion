{
    "name": "clockwork/companion",
    "description": "Companion mu-plugin for the Clockwork monitoring app. Signed REST endpoints under /wp-json/clockwork/v1/.",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ClockworkCompanion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClockworkCompanion\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
